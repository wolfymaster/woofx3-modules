{
  "id": "woofx3_wolfy_profile",
  "name": "Wolfy profile",
  "author": "WolfyMaster LLC",
  "version": "1.2.3",
  "description": "Bundled workflows migrated from woofx3/wooflow/workflows/*.sh. Workflows bind to platform-agnostic event types (`channel.follow`, ...), so no module needs to be installed first; alerts use the workflow engine's built-in `woofx3:action:alert`.",
  "assets": [
    {
      "id": "all-in-this-together",
      "name": "All In This Together",
      "path": "assets/allinthistogether.mp3",
      "kind": "audio"
    },
    {
      "id": "pink-pony-club",
      "name": "Pink Pony Club",
      "path": "assets/goinsane-pinkpony.mp3",
      "kind": "audio"
    },
    {
      "id": "pleasure",
      "name": "Pleasure",
      "path": "assets/pleasure.mp3",
      "kind": "audio"
    },
    {
      "id": "wolf-hype",
      "name": "Wolf Hype",
      "path": "assets/wolf-hype.mp3",
      "kind": "audio"
    },
    {
      "id": "bit_overlay",
      "name": "Bit Overlay",
      "path": "assets/bit_overlay.json",
      "kind": "json"
    },
    {
      "id": "confetti",
      "name": "confetti",
      "path": "assets/confetti2.gif",
      "kind": "gif"
    }
  ],
  "workflows": [
    {
      "id": "follow-workflow",
      "name": "Someone Follows the Stream",
      "trigger": "channel.follow",
      "steps": [
        {
          "id": "alert",
          "type": "action",
          "action": "woofx3:action:alert",
          "parameters": {
            "widget": "MediaWidget",
            "audioUrl": "${asset:pleasure}",
            "mediaUrl": "https://media.tenor.com/LdHGHWDh0Y8AAAPo/look-at-you-i-see-you.mp4",
            "text": "<3  {primary}${trigger.data.userName}{primary} followed <3",
            "duration": 6
          }
        }
      ]
    },
    {
      "id": "subscription-workflow",
      "name": "Someone Subs",
      "trigger": "channel.subscribe",
      "steps": [
        {
          "id": "alert",
          "type": "action",
          "action": "woofx3:action:alert",
          "parameters": {
            "widget": "MediaWidget",
            "audioUrl": "${asset:wolf-hype}",
            "mediaUrl": "https://media.tenor.com/bj2uMQRTdSEAAAPo/dog-husky.mp4",
            "text": "<3  {primary}${trigger.data.userName}{primary} subscribed <3"
          }
        }
      ]
    },
    {
      "id": "bits-workflow",
      "name": "Someone Cheers Bits",
      "trigger": "channel.cheer",
      "steps": [
        {
          "id": "confetti",
          "type": "action",
          "action": "woofx3:action:alert",
          "parameters": {
            "widget": "MediaWidget",
            "mediaUrl": [
              "${asset:bit_overlay}",
              "${asset:confetti}"
            ],
            "audioUrl": "${asset:pink-pony-club}",
            "duration": 10,
            "options": [
              {
                "view": {
                  "fullScreen": true,
                  "positionAbsolute": true
                },
                "animation": {
                  "path": [
                    "assets",
                    0,
                    "layers",
                    0,
                    "t",
                    "d",
                    "k",
                    0,
                    "s",
                    "t"
                  ],
                  "value": "${trigger.data.amount} BITS"
                }
              },
              {
                "view": {
                  "fullScreen": true,
                  "positionAbsolute": true
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "gifted-subscription-workflow",
      "name": "Someone Gifted Subs",
      "trigger": "channel.subscriptionGift",
      "steps": [
        {
          "id": "alert",
          "type": "action",
          "action": "woofx3:action:alert",
          "parameters": {
            "widget": "MediaWidget",
            "audioUrl": "${asset:all-in-this-together}",
            "mediaUrl": "https://media.tenor.com/MojW2yr1vFoAAAPo/money-money-money.mp4",
            "text": "$$ {primary}${trigger.data.gifterName}{primary} gifted {primary}${trigger.data.amount}{primary} {event.data.amount > 1 ? 'subs' : 'sub'} $$"
          }
        }
      ]
    }
  ]
}
