{
  "id": "woofx3_wolfy_profile",
  "name": "Wolfy profile",
  "author": "WolfyMaster LLC.example",
  "version": "2.0.0",
  "description": "Bundled workflows migrated from woofx3/wooflow/workflows/*.sh. Workflows bind to platform-agnostic event types (`channel.follow`, ...), so no module needs to be installed first; alerts use the workflow engine's built-in `woofx3:action:alert`.",
  "assets": [
    {
      "id": "all-in-this-together",
      "name": "All In This Together",
      "path": "assets/allinthistogether.mp3",
      "kind": "audio"
    },
    {
      "id": "pink-pony-club",
      "name": "Pink Pony Club",
      "path": "assets/goinsane-pinkpony.mp3",
      "kind": "audio"
    },
    {
      "id": "pleasure",
      "name": "Pleasure",
      "path": "assets/pleasure.mp3",
      "kind": "audio"
    },
    {
      "id": "wolf-hype",
      "name": "Wolf Hype",
      "path": "assets/wolf-hype.mp3",
      "kind": "audio"
    },
    {
      "id": "bit_overlay",
      "name": "Bit Overlay",
      "path": "assets/bit_overlay.json",
      "kind": "json"
    },
    {
      "id": "confetti",
      "name": "confetti",
      "path": "assets/confetti2.gif",
      "kind": "gif"
    }
  ],
  "workflows": [
    {
      "id": "follow-workflow",
      "name": "Someone Follows the Stream",
      "trigger": "channel.follow",
      "steps": [
        {
          "id": "alert",
          "type": "action",
          "action": "woofx3:action:alert",
          "parameters": {
            "target": "default",
            "layout": {
              "width": 1920,
              "height": 1080,
              "widgets": [
                {
                  "id": "video",
                  "widgetCanonicalId": "woofx3:widget:video",
                  "position": { "x": 16, "y": 16 },
                  "size": { "width": 1888, "height": 880 },
                  "settings": {
                    "src": "https://media.tenor.com/LdHGHWDh0Y8AAAPo/look-at-you-i-see-you.mp4",
                    "loop": true,
                    "duration": 6
                  }
                },
                {
                  "id": "message",
                  "widgetCanonicalId": "woofx3:widget:text",
                  "position": { "x": 16, "y": 908 },
                  "size": { "width": 1888, "height": 156 },
                  "settings": {
                    "text": "<3  {primary}${trigger.data.userName}{primary} followed <3"
                  }
                },
                {
                  "id": "sound",
                  "widgetCanonicalId": "woofx3:widget:audio",
                  "position": { "x": 0, "y": 0 },
                  "size": { "width": 1, "height": 1 },
                  "settings": {
                    "src": "${asset:pleasure}",
                    "duration": 6
                  }
                }
              ]
            }
          }
        }
      ]
    },
    {
      "id": "subscription-workflow",
      "name": "Someone Subs",
      "trigger": "channel.subscribe",
      "steps": [
        {
          "id": "alert",
          "type": "action",
          "action": "woofx3:action:alert",
          "parameters": {
            "target": "default",
            "layout": {
              "width": 1920,
              "height": 1080,
              "widgets": [
                {
                  "id": "video",
                  "widgetCanonicalId": "woofx3:widget:video",
                  "position": { "x": 16, "y": 16 },
                  "size": { "width": 1888, "height": 880 },
                  "settings": {
                    "src": "https://media.tenor.com/bj2uMQRTdSEAAAPo/dog-husky.mp4",
                    "loop": true
                  }
                },
                {
                  "id": "message",
                  "widgetCanonicalId": "woofx3:widget:text",
                  "position": { "x": 16, "y": 908 },
                  "size": { "width": 1888, "height": 156 },
                  "settings": {
                    "text": "<3  {primary}${trigger.data.userName}{primary} subscribed <3"
                  }
                },
                {
                  "id": "sound",
                  "widgetCanonicalId": "woofx3:widget:audio",
                  "position": { "x": 0, "y": 0 },
                  "size": { "width": 1, "height": 1 },
                  "settings": {
                    "src": "${asset:wolf-hype}"
                  }
                }
              ]
            }
          }
        }
      ]
    },
    {
      "id": "bits-workflow",
      "name": "Someone Cheers Bits",
      "trigger": "channel.cheer",
      "steps": [
        {
          "id": "confetti",
          "type": "action",
          "action": "woofx3:action:alert",
          "parameters": {
            "target": "default",
            "layout": {
              "width": 1920,
              "height": 1080,
              "widgets": [
                {
                  "id": "bits",
                  "widgetCanonicalId": "woofx3:widget:lottie",
                  "position": { "x": 0, "y": 0 },
                  "size": { "width": 1920, "height": 1080 },
                  "settings": {
                    "src": "${asset:bit_overlay}",
                    "textLayer": "message.text",
                    "text": "${trigger.data.amount} BITS",
                    "duration": 10
                  }
                },
                {
                  "id": "confetti",
                  "widgetCanonicalId": "woofx3:widget:image",
                  "position": { "x": 0, "y": 0 },
                  "size": { "width": 1920, "height": 1080 },
                  "settings": {
                    "src": "${asset:confetti}",
                    "fit": "cover"
                  }
                },
                {
                  "id": "sound",
                  "widgetCanonicalId": "woofx3:widget:audio",
                  "position": { "x": 0, "y": 0 },
                  "size": { "width": 1, "height": 1 },
                  "settings": {
                    "src": "${asset:pink-pony-club}",
                    "duration": 10
                  }
                }
              ]
            }
          }
        }
      ]
    },
    {
      "id": "gifted-subscription-workflow",
      "name": "Someone Gifted Subs",
      "trigger": "channel.subscriptionGift",
      "steps": [
        {
          "id": "alert",
          "type": "action",
          "action": "woofx3:action:alert",
          "parameters": {
            "target": "default",
            "layout": {
              "width": 1920,
              "height": 1080,
              "widgets": [
                {
                  "id": "video",
                  "widgetCanonicalId": "woofx3:widget:video",
                  "position": { "x": 16, "y": 16 },
                  "size": { "width": 1888, "height": 880 },
                  "settings": {
                    "src": "https://media.tenor.com/MojW2yr1vFoAAAPo/money-money-money.mp4",
                    "loop": true
                  }
                },
                {
                  "id": "message",
                  "widgetCanonicalId": "woofx3:widget:text",
                  "position": { "x": 16, "y": 908 },
                  "size": { "width": 1888, "height": 156 },
                  "settings": {
                    "text": "$$ {primary}${trigger.data.gifterName}{primary} gifted {primary}${trigger.data.amount}{primary} ${trigger.data.amount > 1 ? 'subs' : 'sub'} $$"
                  }
                },
                {
                  "id": "sound",
                  "widgetCanonicalId": "woofx3:widget:audio",
                  "position": { "x": 0, "y": 0 },
                  "size": { "width": 1, "height": 1 },
                  "settings": {
                    "src": "${asset:all-in-this-together}"
                  }
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
