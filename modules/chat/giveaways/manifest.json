{
  "id": "woofx3_giveaways",
  "name": "Giveaways",
  "author": "WolfyMaster LLC",
  "version": "0.1.1",
  "category": "chat",
  "description": "Run giveaways in chat: viewers type a word to enter and you or your mods draw a winner.",
  "taxonomy": [
    "chat.giveaways"
  ],
  "settings": [
    {
      "id": "defaultKeyword",
      "label": "Entry word",
      "description": "What viewers type to enter.",
      "type": "text",
      "defaultValue": "!join"
    },
    {
      "id": "subscriberLuck",
      "label": "Subscriber luck",
      "description": "1 gives everyone the same chance. 2 makes subscribers twice as likely to win.",
      "type": "number",
      "defaultValue": "1"
    },
    {
      "id": "maxEntries",
      "label": "Most entries",
      "description": "Entries close once this many viewers have joined.",
      "type": "number",
      "defaultValue": "1000"
    },
    {
      "id": "announceEntries",
      "label": "Say when someone enters",
      "description": "Best left off in busy chats.",
      "type": "toggle",
      "defaultValue": "false"
    }
  ],
  "functions": [
    {
      "id": "handle_chat_message",
      "name": "Handle chat message",
      "runtime": "js",
      "path": "functions/giveaway.js",
      "entryPoint": "handle_chat_message"
    },
    {
      "id": "start_giveaway",
      "name": "Start giveaway",
      "runtime": "js",
      "path": "functions/giveaway.js",
      "entryPoint": "start_giveaway"
    },
    {
      "id": "draw_winner",
      "name": "Draw winner",
      "runtime": "js",
      "path": "functions/giveaway.js",
      "entryPoint": "draw_winner"
    },
    {
      "id": "end_giveaway",
      "name": "End giveaway",
      "runtime": "js",
      "path": "functions/giveaway.js",
      "entryPoint": "end_giveaway"
    }
  ],
  "actions": [
    {
      "id": "handle_chat_message",
      "name": "Check chat for giveaway entries",
      "description": "Looks for giveaway entries and mod commands in chat. Runs by itself.",
      "type": "function",
      "function": "handle_chat_message",
      "returns": {
        "fields": [
          {
            "path": "handled",
            "type": "string",
            "description": "What the message did: none, entered, started, drawn, ended, cancelled or status."
          }
        ]
      },
      "taxonomy": [
        "chat.giveaways"
      ]
    },
    {
      "id": "start_giveaway",
      "name": "Start giveaway",
      "description": "Opens a giveaway and announces it in chat. Does nothing if one is already open.",
      "type": "function",
      "function": "start_giveaway",
      "schema": [
        {
          "id": "keyword",
          "label": "Entry word",
          "type": "text",
          "placeholder": "!join",
          "description": "What viewers type to enter. Leave blank for your usual entry word."
        },
        {
          "id": "prize",
          "label": "Prize",
          "type": "text",
          "placeholder": "A game key",
          "description": "Mentioned in the announcement. Optional."
        }
      ],
      "returns": {
        "fields": [
          {
            "path": "started",
            "type": "boolean",
            "description": "False when a giveaway was already open."
          },
          {
            "path": "keyword",
            "type": "string"
          }
        ]
      },
      "taxonomy": [
        "chat.giveaways"
      ]
    },
    {
      "id": "draw_winner",
      "name": "Draw giveaway winner",
      "description": "Closes entries and picks a random winner in chat. Drawing again picks someone new.",
      "type": "function",
      "function": "draw_winner",
      "returns": {
        "fields": [
          {
            "path": "winnerName",
            "type": "string",
            "description": "Empty when nobody had entered."
          },
          {
            "path": "winnerId",
            "type": "string"
          },
          {
            "path": "entryCount",
            "type": "number"
          }
        ]
      },
      "taxonomy": [
        "chat.giveaways"
      ]
    },
    {
      "id": "end_giveaway",
      "name": "Close giveaway entries",
      "description": "Stops taking entries without drawing. You can still draw a winner later.",
      "type": "function",
      "function": "end_giveaway",
      "returns": {
        "fields": [
          {
            "path": "entryCount",
            "type": "number"
          }
        ]
      },
      "taxonomy": [
        "chat.giveaways"
      ]
    }
  ],
  "triggers": [
    {
      "id": "giveaway_started",
      "name": "Giveaway started",
      "description": "A giveaway opens for entries.",
      "type": "eventbus",
      "event": "giveaways.started",
      "sentence": "A giveaway starts",
      "taxonomy": [
        "chat.giveaways"
      ],
      "emits": {
        "fields": [
          {
            "path": "keyword",
            "type": "string",
            "description": "What viewers type to enter.",
            "example": "!join"
          },
          {
            "path": "prize",
            "type": "string",
            "description": "Empty when none was given."
          },
          {
            "path": "startedBy",
            "type": "string",
            "description": "The moderator who started it. Empty when a workflow did."
          }
        ]
      }
    },
    {
      "id": "giveaway_entered",
      "name": "Giveaway entry",
      "description": "A viewer enters the giveaway.",
      "type": "eventbus",
      "event": "giveaways.entered",
      "sentence": "Someone enters the giveaway",
      "taxonomy": [
        "chat.giveaways"
      ],
      "emits": {
        "fields": [
          {
            "path": "userName",
            "type": "string"
          },
          {
            "path": "userId",
            "type": "string"
          },
          {
            "path": "entryCount",
            "type": "number",
            "description": "How many viewers have entered, including this one."
          }
        ]
      }
    },
    {
      "id": "giveaway_winner",
      "name": "Giveaway winner drawn",
      "description": "A winner is drawn.",
      "type": "eventbus",
      "event": "giveaways.winner",
      "sentence": "A giveaway winner is drawn",
      "taxonomy": [
        "chat.giveaways"
      ],
      "emits": {
        "fields": [
          {
            "path": "winnerName",
            "type": "string"
          },
          {
            "path": "winnerId",
            "type": "string"
          },
          {
            "path": "prize",
            "type": "string",
            "description": "Empty when none was given."
          },
          {
            "path": "entryCount",
            "type": "number"
          }
        ]
      }
    }
  ],
  "workflows": [
    {
      "id": "giveaway-chat",
      "name": "Giveaways: check chat",
      "trigger": "user.message",
      "steps": [
        {
          "id": "giveaway",
          "type": "action",
          "action": "handle_chat_message"
        }
      ]
    }
  ]
}
