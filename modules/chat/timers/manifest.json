{
  "id": "woofx3_timed_messages",
  "name": "Timed Messages",
  "author": "WolfyMaster LLC",
  "version": "0.1.1",
  "category": "chat",
  "description": "Posts your reminders in chat on a timer while you're live, but only when chat is active.",
  "taxonomy": [
    "chat.timers"
  ],
  "settings": [
    {
      "id": "message1",
      "label": "Message 1",
      "description": "Leave blank to skip it.",
      "type": "text",
      "defaultValue": ""
    },
    {
      "id": "message2",
      "label": "Message 2",
      "description": "Leave blank to skip it.",
      "type": "text",
      "defaultValue": ""
    },
    {
      "id": "message3",
      "label": "Message 3",
      "description": "Leave blank to skip it.",
      "type": "text",
      "defaultValue": ""
    },
    {
      "id": "message4",
      "label": "Message 4",
      "description": "Leave blank to skip it.",
      "type": "text",
      "defaultValue": ""
    },
    {
      "id": "message5",
      "label": "Message 5",
      "description": "Leave blank to skip it.",
      "type": "text",
      "defaultValue": ""
    },
    {
      "id": "intervalMinutes",
      "label": "Minutes between messages",
      "description": "How long to wait before the next message.",
      "type": "number",
      "defaultValue": "15"
    },
    {
      "id": "minChatLines",
      "label": "Chat messages needed in between",
      "description": "How much viewers must chat before the next one posts. 0 posts on the timer alone.",
      "type": "number",
      "defaultValue": "5"
    },
    {
      "id": "onlyWhenLive",
      "label": "Only while live",
      "description": "Post only while you're live.",
      "type": "toggle",
      "defaultValue": "true"
    }
  ],
  "functions": [
    {
      "id": "post_timed_message",
      "name": "Post timed message",
      "runtime": "js",
      "path": "functions/post_timed_message.js",
      "entryPoint": "post_timed_message"
    },
    {
      "id": "count_chat_line",
      "name": "Count chat line",
      "runtime": "js",
      "path": "functions/count_chat_line.js",
      "entryPoint": "count_chat_line"
    },
    {
      "id": "set_live",
      "name": "Set live",
      "runtime": "js",
      "path": "functions/set_live.js",
      "entryPoint": "set_live"
    }
  ],
  "actions": [
    {
      "id": "count_chat_line",
      "name": "Count chat for timed messages",
      "description": "Counts chat activity for timed messages. Runs by itself.",
      "type": "function",
      "function": "count_chat_line",
      "returns": {
        "fields": [
          {
            "path": "chatLines",
            "type": "number",
            "description": "Chat messages since the last timed message."
          }
        ]
      },
      "taxonomy": [
        "chat.timers"
      ]
    },
    {
      "id": "set_live",
      "name": "Tell timed messages you're live",
      "description": "Lets timed messages know whether you're live. Runs by itself.",
      "type": "function",
      "function": "set_live",
      "schema": [
        {
          "id": "live",
          "label": "Live",
          "type": "toggle",
          "defaultValue": true,
          "description": "On when you go live, off when the stream ends."
        }
      ],
      "returns": {
        "fields": [
          {
            "path": "live",
            "type": "boolean"
          }
        ]
      },
      "taxonomy": [
        "chat.timers"
      ]
    }
  ],
  "workflows": [
    {
      "id": "count-chat-lines",
      "name": "Timed messages: count chat activity",
      "trigger": "user.message",
      "steps": [
        {
          "id": "count",
          "type": "action",
          "action": "count_chat_line"
        }
      ]
    },
    {
      "id": "stream-online",
      "name": "Timed messages: stream started",
      "trigger": "stream.online",
      "steps": [
        {
          "id": "live",
          "type": "action",
          "action": "set_live",
          "parameters": {
            "live": true
          }
        }
      ]
    },
    {
      "id": "stream-offline",
      "name": "Timed messages: stream ended",
      "trigger": "stream.offline",
      "steps": [
        {
          "id": "offline",
          "type": "action",
          "action": "set_live",
          "parameters": {
            "live": false
          }
        }
      ]
    }
  ],
  "backgroundTasks": [
    {
      "id": "post_timed_messages",
      "function": "post_timed_message",
      "schedule": "0 * * * * *",
      "description": "Checks once a minute whether the next timed message is due."
    }
  ]
}
