{
  "id": "woofx3_twitch",
  "name": "Twitch Platform",
  "author": "WolfyMaster LLC",
  "version": "0.2.0",
  "category": "platform",
  "description": "Twitch EventSub subscription types as eventbus triggers. Trigger IDs are the NATS subject each event publishes on (see shared/common/typescript/cloudevents/Twitch/events.ts EventType). See https://dev.twitch.tv/docs/eventsub/eventsub-subscription-types/",
  "triggers": [
    {
      "id": "channel_follow",
      "name": "Channel follow",
      "description": "Twitch EventSub: channel.follow",
      "type": "eventbus",
      "event": "channel.follow",
      "taxonomy": [
        "platform.twitch",
        "alert.follow"
      ]
    },
    {
      "id": "user_message",
      "name": "Channel chat message",
      "description": "Twitch EventSub: channel.chat.message",
      "type": "eventbus",
      "event": "user.message",
      "taxonomy": [
        "platform.twitch",
        "alert.chat"
      ]
    },
    {
      "id": "channel_subscribe",
      "name": "Channel subscribe",
      "description": "Twitch EventSub: channel.subscribe",
      "type": "eventbus",
      "event": "channel.subscribe",
      "taxonomy": [
        "platform.twitch",
        "alert.subscription"
      ],
      "allowVariants": true,
      "schema": [
        {
          "id": "tier",
          "label": "Subscription tier",
          "type": "select",
          "required": true,
          "options": [
            {
              "value": "1000",
              "label": "Tier 1"
            },
            {
              "value": "2000",
              "label": "Tier 2"
            },
            {
              "value": "3000",
              "label": "Tier 3"
            }
          ],
          "defaultValue": "1000"
        }
      ]
    },
    {
      "id": "channel_subscription_gift",
      "name": "Channel subscription gift",
      "description": "Twitch EventSub: channel.subscription.gift",
      "type": "eventbus",
      "event": "channel.subscriptionGift",
      "taxonomy": [
        "platform.twitch",
        "alert.subscription"
      ],
      "allowVariants": true,
      "schema": [
        {
          "id": "tier",
          "label": "Gift tier",
          "type": "select",
          "required": true,
          "options": [
            {
              "value": "1000",
              "label": "Tier 1"
            },
            {
              "value": "2000",
              "label": "Tier 2"
            },
            {
              "value": "3000",
              "label": "Tier 3"
            }
          ],
          "defaultValue": "1000"
        },
        {
          "id": "minQuantity",
          "label": "Minimum gift count",
          "type": "number",
          "required": true,
          "min": 1,
          "defaultValue": 1,
          "placeholder": "e.g. 5",
          "eventPath": "total",
          "operator": "gte"
        }
      ]
    },
    {
      "id": "channel_cheer",
      "name": "Channel cheer",
      "description": "Twitch EventSub: channel.cheer",
      "type": "eventbus",
      "event": "channel.cheer",
      "taxonomy": [
        "platform.twitch",
        "alert.cheer"
      ],
      "allowVariants": true,
      "schema": [
        {
          "id": "amount",
          "label": "Minimum bits",
          "type": "number",
          "required": true,
          "min": 1,
          "defaultValue": 100,
          "placeholder": "e.g. 100",
          "eventPath": "amount",
          "operator": "gte",
          "description": "Only fire when the cheer meets or exceeds this amount.",
          "hint": "Compares against the cheer amount on the Twitch channel.cheer event payload (see wolfy_profile workflows).",
          "examplePayload": "{\n  \"amount\": 1000,\n  \"isAnonymous\": false,\n  \"userName\": \"viewer42\",\n  \"userId\": \"123456\",\n  \"message\": \"Cheer1000 woof\"\n}"
        }
      ]
    },
    {
      "id": "channel_hypetrain",
      "name": "Hype train begin",
      "description": "Twitch EventSub: channel.hype_train.begin",
      "type": "eventbus",
      "event": "channel.hypetrain",
      "taxonomy": [
        "platform.twitch",
        "alert.hypetrain"
      ]
    },
    {
      "id": "stream_online",
      "name": "Stream online",
      "description": "Twitch EventSub: stream.online",
      "type": "eventbus",
      "event": "stream.online",
      "taxonomy": [
        "platform.twitch",
        "alert.stream"
      ]
    },
    {
      "id": "channelpoints_redeem",
      "name": "Channel point redemption",
      "description": "Twitch EventSub: channel.channel_points_custom_reward_redemption.add",
      "type": "eventbus",
      "event": "channelpoints.redeem",
      "taxonomy": [
        "platform.twitch",
        "alert.channelpoints"
      ],
      "allowVariants": true,
      "schema": [
        {
          "id": "rewardId",
          "label": "Reward",
          "type": "select",
          "source": {
            "kind": "internal",
            "request": {
              "event": "twitchapi",
              "payload": {
                "command": "listChannelPointRewards",
                "args": {}
              }
            },
            "timeoutMs": 10000
          },
          "required": true,
          "description": "Only fire when the redemption matches this reward.",
          "hint": "Options are loaded live from every custom channel-point reward configured on the broadcaster's channel via twitchapi.listChannelPointRewards. If the list is empty, create a custom reward in the Twitch creator dashboard.",
          "eventPath": "rewardId",
          "operator": "eq",
          "examplePayload": "{\n  \"redeemId\": \"...\",\n  \"rewardId\": \"...\",\n  \"rewardTitle\": \"...\",\n  \"userId\": \"...\",\n  \"userName\": \"...\",\n  \"message\": \"\"\n}"
        }
      ]
    },
    {
      "id": "stream_offline",
      "name": "Stream offline",
      "description": "Twitch EventSub: stream.offline",
      "type": "eventbus",
      "event": "stream.offline",
      "taxonomy": [
        "platform.twitch",
        "alert.stream"
      ]
    },
    {
      "id": "channel_raid",
      "name": "Channel raid",
      "description": "Twitch EventSub: channel.raid",
      "type": "eventbus",
      "event": "channel.raid",
      "taxonomy": [
        "platform.twitch",
        "alert.raid"
      ],
      "allowVariants": true,
      "schema": [
        {
          "id": "minViewers",
          "label": "Minimum viewers",
          "type": "number",
          "required": true,
          "min": 1,
          "defaultValue": 1,
          "placeholder": "e.g. 25",
          "eventPath": "viewers",
          "operator": "gte",
          "description": "Only fire when the raid brings at least this many viewers.",
          "examplePayload": "{\n  \"fromBroadcasterUserId\": \"123456\",\n  \"fromBroadcasterUserName\": \"raider99\",\n  \"viewers\": 50\n}"
        }
      ]
    },
    {
      "id": "channel_resub",
      "name": "Channel resub",
      "description": "Twitch EventSub: channel.chat.notification (resub)",
      "type": "eventbus",
      "event": "channel.resub",
      "taxonomy": [
        "platform.twitch",
        "alert.subscription"
      ],
      "allowVariants": true,
      "schema": [
        {
          "id": "tier",
          "label": "Subscription tier",
          "type": "select",
          "required": true,
          "options": [
            {
              "value": "1000",
              "label": "Tier 1"
            },
            {
              "value": "2000",
              "label": "Tier 2"
            },
            {
              "value": "3000",
              "label": "Tier 3"
            }
          ],
          "defaultValue": "1000",
          "examplePayload": "{\n  \"broadcasterId\": \"123456\",\n  \"broadcasterName\": \"streamer\",\n  \"chatterId\": \"78910\",\n  \"chatterName\": \"viewer42\",\n  \"chatterIsAnonymous\": false,\n  \"tier\": \"1000\",\n  \"isPrime\": false,\n  \"durationMonths\": 1,\n  \"cumulativeMonths\": 6,\n  \"streakMonths\": 3,\n  \"isGift\": false,\n  \"gifterIsAnonymous\": null,\n  \"gifterId\": null,\n  \"gifterName\": null,\n  \"messageId\": \"...\",\n  \"messageText\": \"...\"\n}"
        }
      ]
    },
    {
      "id": "channel_shared_resub",
      "name": "Channel resub (shared chat)",
      "description": "Twitch EventSub: channel.chat.notification (shared_chat_resub) \u2014 fires when the resub is announced in another broadcaster's chat during a shared chat session.",
      "type": "eventbus",
      "event": "channel.sharedResub",
      "taxonomy": [
        "platform.twitch",
        "alert.subscription"
      ],
      "allowVariants": true,
      "schema": [
        {
          "id": "tier",
          "label": "Subscription tier",
          "type": "select",
          "required": true,
          "options": [
            {
              "value": "1000",
              "label": "Tier 1"
            },
            {
              "value": "2000",
              "label": "Tier 2"
            },
            {
              "value": "3000",
              "label": "Tier 3"
            }
          ],
          "defaultValue": "1000"
        }
      ]
    },
    {
      "id": "channel_gift_paid_upgrade",
      "name": "Gift sub upgraded to paid",
      "description": "Twitch EventSub: channel.chat.notification (gift_paid_upgrade) \u2014 a user upgraded their gifted sub to a paid one.",
      "type": "eventbus",
      "event": "channel.giftPaidUpgrade",
      "taxonomy": [
        "platform.twitch",
        "alert.subscription"
      ]
    },
    {
      "id": "channel_shared_gift_paid_upgrade",
      "name": "Gift sub upgraded to paid (shared chat)",
      "description": "Twitch EventSub: channel.chat.notification (shared_chat_gift_paid_upgrade)",
      "type": "eventbus",
      "event": "channel.sharedGiftPaidUpgrade",
      "taxonomy": [
        "platform.twitch",
        "alert.subscription"
      ]
    },
    {
      "id": "channel_prime_paid_upgrade",
      "name": "Prime sub upgraded to paid",
      "description": "Twitch EventSub: channel.chat.notification (prime_paid_upgrade) \u2014 a user upgraded their Prime sub to a paid one.",
      "type": "eventbus",
      "event": "channel.primePaidUpgrade",
      "taxonomy": [
        "platform.twitch",
        "alert.subscription"
      ],
      "allowVariants": true,
      "schema": [
        {
          "id": "tier",
          "label": "Subscription tier",
          "type": "select",
          "required": true,
          "options": [
            {
              "value": "1000",
              "label": "Tier 1"
            },
            {
              "value": "2000",
              "label": "Tier 2"
            },
            {
              "value": "3000",
              "label": "Tier 3"
            }
          ],
          "defaultValue": "1000"
        }
      ]
    },
    {
      "id": "channel_shared_prime_paid_upgrade",
      "name": "Prime sub upgraded to paid (shared chat)",
      "description": "Twitch EventSub: channel.chat.notification (shared_chat_prime_paid_upgrade)",
      "type": "eventbus",
      "event": "channel.sharedPrimePaidUpgrade",
      "taxonomy": [
        "platform.twitch",
        "alert.subscription"
      ],
      "allowVariants": true,
      "schema": [
        {
          "id": "tier",
          "label": "Subscription tier",
          "type": "select",
          "required": true,
          "options": [
            {
              "value": "1000",
              "label": "Tier 1"
            },
            {
              "value": "2000",
              "label": "Tier 2"
            },
            {
              "value": "3000",
              "label": "Tier 3"
            }
          ],
          "defaultValue": "1000"
        }
      ]
    },
    {
      "id": "channel_unraid",
      "name": "Raid cancelled (unraid)",
      "description": "Twitch EventSub: channel.chat.notification (unraid) \u2014 the broadcaster cancelled an outgoing raid.",
      "type": "eventbus",
      "event": "channel.unraid",
      "taxonomy": [
        "platform.twitch",
        "alert.raid"
      ]
    },
    {
      "id": "channel_pay_it_forward",
      "name": "Gift sub paid forward",
      "description": "Twitch EventSub: channel.chat.notification (pay_it_forward) \u2014 a recipient of a gifted sub paid it forward by gifting another sub.",
      "type": "eventbus",
      "event": "channel.payItForward",
      "taxonomy": [
        "platform.twitch",
        "alert.subscription"
      ]
    },
    {
      "id": "channel_shared_pay_it_forward",
      "name": "Gift sub paid forward (shared chat)",
      "description": "Twitch EventSub: channel.chat.notification (shared_chat_pay_it_forward)",
      "type": "eventbus",
      "event": "channel.sharedPayItForward",
      "taxonomy": [
        "platform.twitch",
        "alert.subscription"
      ]
    },
    {
      "id": "channel_announcement",
      "name": "Chat announcement",
      "description": "Twitch EventSub: channel.chat.notification (announcement)",
      "type": "eventbus",
      "event": "channel.announcement",
      "taxonomy": [
        "platform.twitch",
        "alert.chat"
      ],
      "allowVariants": true,
      "schema": [
        {
          "id": "color",
          "label": "Announcement color",
          "type": "select",
          "required": true,
          "options": [
            {
              "value": "primary",
              "label": "Primary"
            },
            {
              "value": "blue",
              "label": "Blue"
            },
            {
              "value": "green",
              "label": "Green"
            },
            {
              "value": "orange",
              "label": "Orange"
            },
            {
              "value": "purple",
              "label": "Purple"
            }
          ],
          "defaultValue": "primary",
          "examplePayload": "{\n  \"broadcasterId\": \"123456\",\n  \"broadcasterName\": \"streamer\",\n  \"chatterId\": \"78910\",\n  \"chatterName\": \"moderator1\",\n  \"color\": \"primary\",\n  \"messageId\": \"...\",\n  \"messageText\": \"Going live in 5 minutes!\"\n}"
        }
      ]
    },
    {
      "id": "channel_shared_announcement",
      "name": "Chat announcement (shared chat)",
      "description": "Twitch EventSub: channel.chat.notification (shared_chat_announcement)",
      "type": "eventbus",
      "event": "channel.sharedAnnouncement",
      "taxonomy": [
        "platform.twitch",
        "alert.chat"
      ],
      "allowVariants": true,
      "schema": [
        {
          "id": "color",
          "label": "Announcement color",
          "type": "select",
          "required": true,
          "options": [
            {
              "value": "primary",
              "label": "Primary"
            },
            {
              "value": "blue",
              "label": "Blue"
            },
            {
              "value": "green",
              "label": "Green"
            },
            {
              "value": "orange",
              "label": "Orange"
            },
            {
              "value": "purple",
              "label": "Purple"
            }
          ],
          "defaultValue": "primary"
        }
      ]
    },
    {
      "id": "channel_charity_donation",
      "name": "Charity donation",
      "description": "Twitch EventSub: channel.chat.notification (charity_donation)",
      "type": "eventbus",
      "event": "channel.charityDonation",
      "taxonomy": [
        "platform.twitch",
        "alert.donation"
      ],
      "allowVariants": true,
      "schema": [
        {
          "id": "minAmount",
          "label": "Minimum donation amount",
          "type": "number",
          "required": true,
          "min": 0,
          "defaultValue": 5,
          "placeholder": "e.g. 5",
          "eventPath": "amount",
          "operator": "gte",
          "description": "Only fire when the donation meets or exceeds this amount, in the currency's major unit (e.g. dollars, not cents).",
          "examplePayload": "{\n  \"broadcasterId\": \"123456\",\n  \"broadcasterName\": \"streamer\",\n  \"chatterId\": \"78910\",\n  \"chatterName\": \"viewer42\",\n  \"charityName\": \"Direct Relief\",\n  \"amount\": 25.5,\n  \"currency\": \"USD\"\n}"
        }
      ]
    },
    {
      "id": "channel_bits_badge_tier",
      "name": "New bits badge tier reached",
      "description": "Twitch EventSub: channel.chat.notification (bits_badge_tier)",
      "type": "eventbus",
      "event": "channel.bitsBadgeTier",
      "taxonomy": [
        "platform.twitch",
        "alert.cheer"
      ],
      "allowVariants": true,
      "schema": [
        {
          "id": "minTier",
          "label": "Minimum tier",
          "type": "number",
          "required": true,
          "min": 1,
          "defaultValue": 1,
          "placeholder": "e.g. 1000",
          "eventPath": "newTier",
          "operator": "gte",
          "description": "Only fire when the newly reached bits badge tier meets or exceeds this value.",
          "examplePayload": "{\n  \"broadcasterId\": \"123456\",\n  \"broadcasterName\": \"streamer\",\n  \"chatterId\": \"78910\",\n  \"chatterName\": \"viewer42\",\n  \"newTier\": 1000\n}"
        }
      ]
    },
    {
      "id": "channel_watch_streak",
      "name": "Watch streak milestone",
      "description": "Twitch EventSub: channel.chat.notification (watch_streak)",
      "type": "eventbus",
      "event": "channel.watchStreak",
      "taxonomy": [
        "platform.twitch",
        "alert.watchstreak"
      ],
      "allowVariants": true,
      "schema": [
        {
          "id": "minStreakCount",
          "label": "Minimum streak count",
          "type": "number",
          "required": true,
          "min": 1,
          "defaultValue": 1,
          "placeholder": "e.g. 5",
          "eventPath": "streakCount",
          "operator": "gte",
          "description": "Only fire when the watch streak meets or exceeds this many consecutive broadcasts.",
          "examplePayload": "{\n  \"broadcasterId\": \"123456\",\n  \"broadcasterName\": \"streamer\",\n  \"chatterId\": \"78910\",\n  \"chatterName\": \"viewer42\",\n  \"streakCount\": 5,\n  \"channelPointsAwarded\": 500\n}"
        }
      ]
    }
  ],
  "functions": [
    {
      "id": "sendChatMessage",
      "name": "Send chat message",
      "runtime": "js",
      "path": "functions/sendChatMessage.js",
      "entryPoint": "sendChatMessage"
    }
  ],
  "actions": [
    {
      "id": "twitch.chat.send",
      "name": "Send chat message",
      "description": "Publish a message to Twitch chat on the broadcaster channel.",
      "type": "function",
      "function": "sendChatMessage",
      "schema": [
        {
          "id": "message",
          "label": "Message",
          "type": "text",
          "required": true,
          "placeholder": "What should the bot say?",
          "description": "Plain text. Twitch chat enforces a 500-character limit.",
          "hint": "Supports template substitution from the trigger event (e.g. {user.name})."
        }
      ]
    }
  ]
}
