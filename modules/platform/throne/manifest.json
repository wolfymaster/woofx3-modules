{
  "id": "woofx3_throne",
  "name": "Throne Platform",
  "author": "WolfyMaster LLC",
  "version": "0.2.0",
  "category": "platform",
  "description": "React when someone buys a gift, chips in, or fully funds a gift on your Throne wishlist.",
  "functions": [
    {
      "id": "handle_throne_webhook",
      "name": "Handle Throne message",
      "runtime": "js",
      "path": "functions/handle_throne_webhook.js",
      "entryPoint": "handle_throne_webhook"
    }
  ],
  "triggers": [
    {
      "id": "throne_webhook",
      "name": "Throne link",
      "description": "Paste this link into Throne's webhook settings. Only real Throne messages count.",
      "type": "webhook",
      "handler": "handle_throne_webhook"
    },
    {
      "id": "gift_purchased",
      "name": "Someone buys you a gift",
      "description": "Someone buys a gift from your Throne wishlist.",
      "type": "eventbus",
      "event": "throne.gift.purchased",
      "taxonomy": ["platform.throne", "alert.gift"],
      "emits": {
        "summary": "{gifterUsername} sent {itemName}",
        "details": ["{priceDisplay}", "“{message}”"],
        "fields": [
          { "path": "eventId", "type": "string", "description": "Throne's id for this message. A resend carries the same id." },
          { "path": "creatorUsername", "type": "string", "description": "Your Throne username." },
          { "path": "gifterUsername", "type": "string", "description": "Who bought the gift. \"Anonymous\" when they hid their name.", "example": "Anonymous" },
          { "path": "message", "type": "string", "description": "The gifter's message. Empty when they left none." },
          { "path": "itemName", "type": "string", "example": "Mechanical Keyboard" },
          { "path": "itemThumbnailUrl", "type": "string" },
          { "path": "price", "type": "number", "description": "The price in hundredths of the currency: 1099 is 10.99.", "example": 1099 },
          { "path": "priceDisplay", "type": "string", "description": "The price with two decimals, like 10.99.", "example": "10.99" },
          { "path": "currency", "type": "string", "description": "Currency code, like USD.", "example": "USD" },
          { "path": "isSurpriseGift", "type": "boolean" }
        ]
      }
    },
    {
      "id": "contribution_purchased",
      "name": "Someone chips in toward a gift",
      "description": "Someone contributes toward a gift on your wishlist.",
      "type": "eventbus",
      "event": "throne.contribution.purchased",
      "taxonomy": ["platform.throne", "alert.contribution"],
      "emits": {
        "summary": "{gifterUsername} contributed {amountDisplay} to {itemName}",
        "details": ["“{message}”"],
        "fields": [
          { "path": "eventId", "type": "string", "description": "Throne's id for this message. A resend carries the same id." },
          { "path": "creatorUsername", "type": "string", "description": "Your Throne username." },
          { "path": "gifterUsername", "type": "string", "description": "Who contributed. \"Anonymous\" when they hid their name.", "example": "Anonymous" },
          { "path": "message", "type": "string", "description": "The contributor's message. Empty when they left none." },
          { "path": "itemName", "type": "string", "example": "Mechanical Keyboard" },
          { "path": "itemThumbnailUrl", "type": "string" },
          { "path": "amount", "type": "number", "description": "The price in hundredths of the currency: 1099 is 10.99.", "example": 1099 },
          { "path": "amountDisplay", "type": "string", "description": "The amount with two decimals, like 10.99.", "example": "10.99" },
          { "path": "currency", "type": "string", "description": "Currency code, like USD.", "example": "USD" }
        ]
      }
    },
    {
      "id": "gift_crowdfunded",
      "name": "A gift is fully funded",
      "description": "Contributions fully pay for a gift on your wishlist.",
      "type": "eventbus",
      "event": "throne.gift.crowdfunded",
      "taxonomy": ["platform.throne", "alert.gift"],
      "emits": {
        "summary": "{itemName} was fully crowdfunded",
        "details": ["{priceDisplay}"],
        "fields": [
          { "path": "eventId", "type": "string", "description": "Throne's id for this message. A resend carries the same id." },
          { "path": "creatorUsername", "type": "string", "description": "Your Throne username." },
          { "path": "itemName", "type": "string", "example": "Mechanical Keyboard" },
          { "path": "itemThumbnailUrl", "type": "string" },
          { "path": "price", "type": "number", "description": "The price in hundredths of the currency: 1099 is 10.99.", "example": 1099 },
          { "path": "priceDisplay", "type": "string", "description": "The price with two decimals, like 10.99.", "example": "10.99" },
          { "path": "currency", "type": "string", "description": "Currency code, like USD.", "example": "USD" },
          { "path": "isSurpriseGift", "type": "boolean" }
        ]
      }
    }
  ]
}
