{
  "id": "woofx3_kofi",
  "name": "Ko-fi",
  "author": "WolfyMaster LLC",
  "version": "0.2.0",
  "category": "platform",
  "description": "Know when someone tips, joins or renews a membership, buys from your shop, or orders a commission.",
  "taxonomy": [
    "platform.kofi"
  ],
  "functions": [
    {
      "id": "handle_kofi_webhook",
      "name": "Receive Ko-fi events",
      "runtime": "js",
      "path": "functions/handle_kofi_webhook.js",
      "entryPoint": "handle_kofi_webhook"
    }
  ],
  "settings": [
    {
      "id": "verificationToken",
      "label": "Ko-fi verification code",
      "description": "Copy it from the Advanced section of Ko-fi's API page.",
      "type": "secret",
      "required": true
    }
  ],
  "triggers": [
    {
      "id": "kofi_webhook",
      "name": "Ko-fi link",
      "description": "The link you paste into Ko-fi so it can tell woofx3 about tips, members and orders.",
      "type": "webhook",
      "handler": "handle_kofi_webhook"
    },
    {
      "id": "donation",
      "name": "Someone tips on Ko-fi",
      "description": "When someone sends a one-time tip on Ko-fi.",
      "type": "eventbus",
      "event": "kofi.donation",
      "sentence": "Someone tips on Ko-fi",
      "taxonomy": [
        "platform.kofi",
        "alert.donation"
      ],
      "emits": {
        "summary": "{fromName} donated {amountDisplay}",
        "details": [
          "“{message}”"
        ],
        "fields": [
          {
            "path": "messageId",
            "type": "string",
            "description": "Ko-fi's reference for this payment."
          },
          {
            "path": "fromName",
            "type": "string",
            "description": "Who supported you. \"Anonymous\" if they want privacy.",
            "example": "Anonymous"
          },
          {
            "path": "message",
            "type": "string",
            "description": "The supporter's message. Blank if none or private."
          },
          {
            "path": "isPublic",
            "type": "boolean",
            "description": "False when they asked to keep their name and message off stream."
          },
          {
            "path": "amount",
            "type": "number",
            "description": "The amount, like 3 for 3.00.",
            "example": 3
          },
          {
            "path": "amountDisplay",
            "type": "string",
            "description": "The amount with two decimals, like 3.00.",
            "example": "3.00"
          },
          {
            "path": "currency",
            "type": "string",
            "description": "Currency code, like USD.",
            "example": "USD"
          },
          {
            "path": "url",
            "type": "string",
            "description": "Link to the payment on Ko-fi."
          }
        ]
      }
    },
    {
      "id": "subscription",
      "name": "Someone pays for a Ko-fi membership",
      "description": "When someone starts a membership or monthly tip, and again on each renewal.",
      "type": "eventbus",
      "event": "kofi.subscription",
      "sentence": "Someone pays for a Ko-fi membership",
      "taxonomy": [
        "platform.kofi",
        "alert.subscription"
      ],
      "emits": {
        "summary": "{fromName} paid {amountDisplay} for {tierName}",
        "details": [
          "“{message}”"
        ],
        "fields": [
          {
            "path": "messageId",
            "type": "string",
            "description": "Ko-fi's reference for this payment."
          },
          {
            "path": "fromName",
            "type": "string",
            "description": "Who supported you. \"Anonymous\" if they want privacy.",
            "example": "Anonymous"
          },
          {
            "path": "message",
            "type": "string",
            "description": "The supporter's message. Blank if none or private."
          },
          {
            "path": "isPublic",
            "type": "boolean",
            "description": "False when they asked to keep their name and message off stream."
          },
          {
            "path": "amount",
            "type": "number",
            "description": "The amount, like 3 for 3.00.",
            "example": 3
          },
          {
            "path": "amountDisplay",
            "type": "string",
            "description": "The amount with two decimals, like 3.00.",
            "example": "3.00"
          },
          {
            "path": "currency",
            "type": "string",
            "description": "Currency code, like USD.",
            "example": "USD"
          },
          {
            "path": "url",
            "type": "string",
            "description": "Link to the payment on Ko-fi."
          },
          {
            "path": "tierName",
            "type": "string",
            "description": "The membership tier. Blank for a plain monthly tip."
          },
          {
            "path": "isFirstPayment",
            "type": "boolean",
            "description": "True for a new member, false for a renewal."
          }
        ]
      }
    },
    {
      "id": "shop_order",
      "name": "Someone buys from your Ko-fi shop",
      "description": "When someone buys from your Ko-fi shop.",
      "type": "eventbus",
      "event": "kofi.shop_order",
      "sentence": "Someone buys from your Ko-fi shop",
      "taxonomy": [
        "platform.kofi",
        "alert.purchase"
      ],
      "emits": {
        "summary": "{fromName} placed a {amountDisplay} shop order",
        "details": [
          "Items: {itemCount}",
          "“{message}”"
        ],
        "fields": [
          {
            "path": "messageId",
            "type": "string",
            "description": "Ko-fi's reference for this payment."
          },
          {
            "path": "fromName",
            "type": "string",
            "description": "Who supported you. \"Anonymous\" if they want privacy.",
            "example": "Anonymous"
          },
          {
            "path": "message",
            "type": "string",
            "description": "The supporter's message. Blank if none or private."
          },
          {
            "path": "isPublic",
            "type": "boolean",
            "description": "False when they asked to keep their name and message off stream."
          },
          {
            "path": "amount",
            "type": "number",
            "description": "The amount, like 3 for 3.00.",
            "example": 3
          },
          {
            "path": "amountDisplay",
            "type": "string",
            "description": "The amount with two decimals, like 3.00.",
            "example": "3.00"
          },
          {
            "path": "currency",
            "type": "string",
            "description": "Currency code, like USD.",
            "example": "USD"
          },
          {
            "path": "url",
            "type": "string",
            "description": "Link to the payment on Ko-fi."
          },
          {
            "path": "itemCount",
            "type": "number",
            "description": "How many items were bought.",
            "example": 1
          }
        ]
      }
    },
    {
      "id": "commission",
      "name": "Someone orders a commission",
      "description": "When someone orders a commission on Ko-fi.",
      "type": "eventbus",
      "event": "kofi.commission",
      "sentence": "Someone orders a Ko-fi commission",
      "taxonomy": [
        "platform.kofi",
        "alert.purchase"
      ],
      "emits": {
        "summary": "{fromName} paid {amountDisplay} for a commission",
        "details": [
          "“{message}”"
        ],
        "fields": [
          {
            "path": "messageId",
            "type": "string",
            "description": "Ko-fi's reference for this payment."
          },
          {
            "path": "fromName",
            "type": "string",
            "description": "Who supported you. \"Anonymous\" if they want privacy.",
            "example": "Anonymous"
          },
          {
            "path": "message",
            "type": "string",
            "description": "The supporter's message. Blank if none or private."
          },
          {
            "path": "isPublic",
            "type": "boolean",
            "description": "False when they asked to keep their name and message off stream."
          },
          {
            "path": "amount",
            "type": "number",
            "description": "The amount, like 3 for 3.00.",
            "example": 3
          },
          {
            "path": "amountDisplay",
            "type": "string",
            "description": "The amount with two decimals, like 3.00.",
            "example": "3.00"
          },
          {
            "path": "currency",
            "type": "string",
            "description": "Currency code, like USD.",
            "example": "USD"
          },
          {
            "path": "url",
            "type": "string",
            "description": "Link to the payment on Ko-fi."
          }
        ]
      }
    }
  ]
}
