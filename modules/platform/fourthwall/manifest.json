{
  "id": "woofx3_fourthwall",
  "name": "Fourthwall",
  "author": "WolfyMaster LLC",
  "version": "0.2.0",
  "category": "platform",
  "description": "Know when someone donates, orders merch, buys gifts for your community, or joins your membership.",
  "taxonomy": [
    "platform.fourthwall"
  ],
  "functions": [
    {
      "id": "handle_fourthwall_webhook",
      "name": "Receive Fourthwall events",
      "runtime": "js",
      "path": "functions/handle_fourthwall_webhook.js",
      "entryPoint": "handle_fourthwall_webhook"
    }
  ],
  "settings": [
    {
      "id": "webhookSecret",
      "label": "Fourthwall secret",
      "description": "Find it in Fourthwall under Settings, then For developers.",
      "type": "secret",
      "required": true
    }
  ],
  "triggers": [
    {
      "id": "fourthwall_webhook",
      "name": "Fourthwall link",
      "description": "The link you paste into Fourthwall so it can tell woofx3 about donations, orders and members.",
      "type": "webhook",
      "handler": "handle_fourthwall_webhook"
    },
    {
      "id": "donation",
      "name": "Someone donates on Fourthwall",
      "description": "When someone donates through your Fourthwall shop.",
      "type": "eventbus",
      "event": "fourthwall.donation",
      "sentence": "Someone donates on Fourthwall",
      "taxonomy": [
        "platform.fourthwall",
        "alert.donation"
      ],
      "emits": {
        "summary": "{username} donated {amountDisplay}",
        "details": [
          "“{message}”"
        ],
        "fields": [
          {
            "path": "eventId",
            "type": "string",
            "description": "Fourthwall's reference for this event."
          },
          {
            "path": "username",
            "type": "string",
            "description": "Who paid, as they chose to show it. Blank if they gave none."
          },
          {
            "path": "message",
            "type": "string",
            "description": "The buyer's message. Blank if they left none."
          },
          {
            "path": "amount",
            "type": "number",
            "description": "The amount, like 10 for 10.00.",
            "example": 10
          },
          {
            "path": "amountDisplay",
            "type": "string",
            "description": "The amount with two decimals, like 10.00.",
            "example": "10.00"
          },
          {
            "path": "currency",
            "type": "string",
            "description": "Currency code, like USD.",
            "example": "USD"
          },
          {
            "path": "isTest",
            "type": "boolean",
            "description": "True for a test from Fourthwall."
          }
        ]
      }
    },
    {
      "id": "order_placed",
      "name": "Someone orders your merch",
      "description": "When someone buys merch from your Fourthwall shop.",
      "type": "eventbus",
      "event": "fourthwall.order.placed",
      "sentence": "Someone orders your merch",
      "taxonomy": [
        "platform.fourthwall",
        "alert.purchase"
      ],
      "emits": {
        "summary": "{username} ordered {itemNames}",
        "details": [
          "{amountDisplay}",
          "“{message}”"
        ],
        "fields": [
          {
            "path": "eventId",
            "type": "string",
            "description": "Fourthwall's reference for this event."
          },
          {
            "path": "username",
            "type": "string",
            "description": "Who paid, as they chose to show it. Blank if they gave none."
          },
          {
            "path": "message",
            "type": "string",
            "description": "The buyer's message. Blank if they left none."
          },
          {
            "path": "amount",
            "type": "number",
            "description": "The amount, like 10 for 10.00.",
            "example": 10
          },
          {
            "path": "amountDisplay",
            "type": "string",
            "description": "The amount with two decimals, like 10.00.",
            "example": "10.00"
          },
          {
            "path": "currency",
            "type": "string",
            "description": "Currency code, like USD.",
            "example": "USD"
          },
          {
            "path": "isTest",
            "type": "boolean",
            "description": "True for a test from Fourthwall."
          },
          {
            "path": "itemCount",
            "type": "number",
            "description": "How many items were in the order.",
            "example": 2
          },
          {
            "path": "itemNames",
            "type": "string",
            "description": "The products ordered, separated by commas.",
            "example": "Wolf Hoodie, Sticker Pack"
          }
        ]
      }
    },
    {
      "id": "gift_purchase",
      "name": "Someone buys gifts for your community",
      "description": "When someone buys items to give away to your community.",
      "type": "eventbus",
      "event": "fourthwall.gift.purchased",
      "sentence": "Someone buys gifts for your community",
      "taxonomy": [
        "platform.fourthwall",
        "alert.gift"
      ],
      "emits": {
        "summary": "{username} gifted {quantity} × {itemName}",
        "details": [
          "{amountDisplay}",
          "“{message}”"
        ],
        "fields": [
          {
            "path": "eventId",
            "type": "string",
            "description": "Fourthwall's reference for this event."
          },
          {
            "path": "username",
            "type": "string",
            "description": "Who paid, as they chose to show it. Blank if they gave none."
          },
          {
            "path": "message",
            "type": "string",
            "description": "The buyer's message. Blank if they left none."
          },
          {
            "path": "amount",
            "type": "number",
            "description": "The amount, like 10 for 10.00.",
            "example": 10
          },
          {
            "path": "amountDisplay",
            "type": "string",
            "description": "The amount with two decimals, like 10.00.",
            "example": "10.00"
          },
          {
            "path": "currency",
            "type": "string",
            "description": "Currency code, like USD.",
            "example": "USD"
          },
          {
            "path": "isTest",
            "type": "boolean",
            "description": "True for a test from Fourthwall."
          },
          {
            "path": "quantity",
            "type": "number",
            "description": "How many gifts they bought.",
            "example": 5
          },
          {
            "path": "itemName",
            "type": "string",
            "description": "The product being gifted.",
            "example": "Wolf Hoodie"
          }
        ]
      }
    },
    {
      "id": "subscription_purchased",
      "name": "Someone joins your membership",
      "description": "When someone joins your Fourthwall membership.",
      "type": "eventbus",
      "event": "fourthwall.subscription.purchased",
      "sentence": "Someone joins your Fourthwall membership",
      "taxonomy": [
        "platform.fourthwall",
        "alert.subscription"
      ],
      "emits": {
        "summary": "{username} became a member",
        "details": [
          "{amountDisplay} / {interval}"
        ],
        "fields": [
          {
            "path": "eventId",
            "type": "string",
            "description": "Fourthwall's reference for this event."
          },
          {
            "path": "username",
            "type": "string",
            "description": "The member's nickname."
          },
          {
            "path": "amount",
            "type": "number",
            "description": "What they pay each month or year.",
            "example": 5
          },
          {
            "path": "amountDisplay",
            "type": "string",
            "description": "The amount with two decimals, like 10.00.",
            "example": "5.00"
          },
          {
            "path": "currency",
            "type": "string",
            "description": "Currency code, like USD.",
            "example": "USD"
          },
          {
            "path": "interval",
            "type": "string",
            "description": "Monthly or annual.",
            "example": "MONTHLY"
          },
          {
            "path": "isTest",
            "type": "boolean",
            "description": "True for a test from Fourthwall."
          }
        ]
      }
    }
  ]
}
