{
  "id": "woofx3_buymeacoffee",
  "name": "Buy Me a Coffee",
  "author": "WolfyMaster LLC",
  "version": "0.2.0",
  "category": "platform",
  "description": "Know when someone buys you a coffee, joins your membership, or cancels it, and react on stream.",
  "taxonomy": [
    "platform.buymeacoffee"
  ],
  "functions": [
    {
      "id": "handle_bmc_webhook",
      "name": "Receive Buy Me a Coffee events",
      "runtime": "js",
      "path": "functions/handle_bmc_webhook.js",
      "entryPoint": "handle_bmc_webhook"
    }
  ],
  "settings": [
    {
      "id": "signingSecret",
      "label": "Buy Me a Coffee secret",
      "description": "Buy Me a Coffee shows it when you set up the connection.",
      "type": "secret",
      "required": true
    }
  ],
  "triggers": [
    {
      "id": "bmc_webhook",
      "name": "Buy Me a Coffee link",
      "description": "The link you paste into Buy Me a Coffee so it can tell woofx3 about new support.",
      "type": "webhook",
      "handler": "handle_bmc_webhook"
    },
    {
      "id": "donation",
      "name": "Someone buys you a coffee",
      "description": "When someone buys you a coffee.",
      "type": "eventbus",
      "event": "buymeacoffee.donation",
      "sentence": "Someone buys you a coffee",
      "taxonomy": [
        "platform.buymeacoffee",
        "alert.donation"
      ],
      "emits": {
        "summary": "{supporterName} supported with {amountDisplay}",
        "details": [
          "Coffees: {coffeeCount}",
          "“{message}”"
        ],
        "fields": [
          {
            "path": "eventId",
            "type": "string",
            "description": "Buy Me a Coffee's reference for this event."
          },
          {
            "path": "supporterName",
            "type": "string",
            "description": "Who supported you, as they chose to show it.",
            "example": "Alex"
          },
          {
            "path": "message",
            "type": "string",
            "description": "The supporter's note. Blank if they left none or hid it."
          },
          {
            "path": "amount",
            "type": "number",
            "description": "The amount, like 15 for 15.00.",
            "example": 15
          },
          {
            "path": "amountDisplay",
            "type": "string",
            "description": "The amount with two decimals, like 15.00.",
            "example": "15.00"
          },
          {
            "path": "currency",
            "type": "string",
            "description": "Currency code, like USD.",
            "example": "USD"
          },
          {
            "path": "isTest",
            "type": "boolean",
            "description": "True for a test sent from Buy Me a Coffee."
          },
          {
            "path": "coffeeCount",
            "type": "number",
            "description": "How many coffees they bought.",
            "example": 3
          }
        ]
      }
    },
    {
      "id": "membership_started",
      "name": "Someone joins your membership",
      "description": "When someone joins one of your memberships.",
      "type": "eventbus",
      "event": "buymeacoffee.membership.started",
      "sentence": "Someone joins your Buy Me a Coffee membership",
      "taxonomy": [
        "platform.buymeacoffee",
        "alert.subscription"
      ],
      "emits": {
        "summary": "{supporterName} joined {levelName}",
        "details": [
          "{amountDisplay} / {interval}",
          "“{message}”"
        ],
        "fields": [
          {
            "path": "eventId",
            "type": "string",
            "description": "Buy Me a Coffee's reference for this event."
          },
          {
            "path": "supporterName",
            "type": "string",
            "description": "Who supported you, as they chose to show it.",
            "example": "Alex"
          },
          {
            "path": "message",
            "type": "string",
            "description": "The supporter's note. Blank if they left none or hid it."
          },
          {
            "path": "amount",
            "type": "number",
            "description": "The amount, like 15 for 15.00.",
            "example": 15
          },
          {
            "path": "amountDisplay",
            "type": "string",
            "description": "The amount with two decimals, like 15.00.",
            "example": "15.00"
          },
          {
            "path": "currency",
            "type": "string",
            "description": "Currency code, like USD.",
            "example": "USD"
          },
          {
            "path": "isTest",
            "type": "boolean",
            "description": "True for a test sent from Buy Me a Coffee."
          },
          {
            "path": "levelName",
            "type": "string",
            "description": "The membership level they joined.",
            "example": "Gold supporter"
          },
          {
            "path": "interval",
            "type": "string",
            "description": "Month or year.",
            "example": "month"
          }
        ]
      }
    },
    {
      "id": "membership_cancelled",
      "name": "Someone cancels their membership",
      "description": "When someone cancels one of your memberships.",
      "type": "eventbus",
      "event": "buymeacoffee.membership.cancelled",
      "sentence": "Someone cancels their Buy Me a Coffee membership",
      "taxonomy": [
        "platform.buymeacoffee"
      ],
      "emits": {
        "summary": "{supporterName} canceled {levelName}",
        "fields": [
          {
            "path": "eventId",
            "type": "string",
            "description": "Buy Me a Coffee's reference for this event."
          },
          {
            "path": "supporterName",
            "type": "string",
            "description": "Who canceled.",
            "example": "Alex"
          },
          {
            "path": "levelName",
            "type": "string",
            "description": "The membership level they left.",
            "example": "Gold supporter"
          },
          {
            "path": "isTest",
            "type": "boolean",
            "description": "True for a test sent from Buy Me a Coffee."
          }
        ]
      }
    }
  ]
}
