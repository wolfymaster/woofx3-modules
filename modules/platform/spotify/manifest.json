{
  "id": "woofx3_spotify",
  "name": "Spotify Song Request",
  "author": "WolfyMaster LLC",
  "version": "0.4.2",
  "category": "platform",
  "description": "Let viewers add songs to your Spotify queue with !sr, and show what's playing.",
  "functions": [
    {
      "id": "song_request",
      "name": "Song request",
      "runtime": "js",
      "path": "functions/song_request.js",
      "entryPoint": "song_request"
    },
    {
      "id": "poll_current_track",
      "name": "Check current song",
      "runtime": "js",
      "path": "functions/poll_current_track.js",
      "entryPoint": "poll_current_track"
    },
    {
      "id": "get_devices",
      "name": "List devices",
      "runtime": "js",
      "path": "functions/get_devices.js",
      "entryPoint": "get_devices"
    }
  ],
  "actions": [
    {
      "id": "song_request",
      "name": "Queue song request",
      "description": "Find the song a viewer asked for and add it to your Spotify queue.",
      "type": "function",
      "function": "song_request",
      "schema": [
        {
          "id": "deviceId",
          "label": "Speaker",
          "type": "select",
          "required": false,
          "defaultValue": "",
          "description": "Leave blank to use whatever Spotify is playing on now.",
          "source": {
            "kind": "internal",
            "request": {
              "event": "barkloader.module.field_options",
              "payload": {
                "moduleId": "woofx3_spotify",
                "functionId": "get_devices"
              }
            },
            "timeoutMs": 10000
          }
        }
      ],
      "returns": {
        "fields": [
          {
            "path": "song",
            "type": "string",
            "description": "The song that was added."
          },
          {
            "path": "artist",
            "type": "string",
            "description": "The song's artist."
          }
        ]
      }
    }
  ],
  "triggers": [
    {
      "id": "sr_command",
      "name": "Someone uses !sr",
      "description": "A viewer asks for a song in chat.",
      "type": "eventbus",
      "event": "chat.command.sr",
      "category": "chat"
    }
  ],
  "commands": [
    {
      "id": "sr",
      "name": "Song request",
      "pattern": "!sr",
      "type": "prefix",
      "actions": [
        {
          "id": "queue_song",
          "action": "song_request"
        }
      ]
    }
  ],
  "background_tasks": [
    {
      "id": "poll_now_playing",
      "function": "poll_current_track",
      "schedule": "*/30 * * * * *",
      "description": "Keeps the Now Playing display up to date."
    }
  ],
  "settings": [
    {
      "id": "authorizeSpotify",
      "label": "Authorize Spotify",
      "description": "Connect your Spotify account.",
      "type": "button",
      "action": {
        "kind": "integration",
        "integration": "spotify"
      }
    },
    {
      "id": "clientId",
      "label": "Spotify app ID",
      "description": "Optional. Use your own Spotify app instead of the one woofx3 provides.",
      "type": "text",
      "required": false
    }
  ],
  "oauth": [
    {
      "id": "spotify",
      "authorizeUrl": "https://accounts.spotify.com/authorize",
      "tokenUrl": "https://accounts.spotify.com/api/token",
      "scopes": [
        "user-read-playback-state",
        "user-modify-playback-state",
        "user-read-currently-playing"
      ],
      "clientIdSetting": "clientId",
      "hosts": [
        "api.spotify.com"
      ]
    }
  ],
  "widgets": [
    {
      "id": "now_playing",
      "name": "Now Playing",
      "description": "Shows the song that's playing right now.",
      "entry": "widgets/now_playing/index.html",
      "assets": "widgets/now_playing",
      "alertTypes": [
        "module.storage.changed"
      ]
    }
  ]
}
