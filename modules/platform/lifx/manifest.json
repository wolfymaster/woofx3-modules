{
  "id": "woofx3_lifx",
  "name": "LIFX",
  "author": "WolfyMaster LLC",
  "version": "0.1.2",
  "category": "platform",
  "description": "Turn your LIFX lights on or off, change their color, and flash them for alerts.",
  "taxonomy": [
    "platform.lifx"
  ],
  "settings": [
    {
      "id": "apiToken",
      "label": "LIFX token",
      "type": "secret",
      "required": true,
      "description": "Your LIFX personal access token."
    }
  ],
  "functions": [
    {
      "id": "setState",
      "name": "Set light state",
      "runtime": "js",
      "path": "functions/setState.js",
      "entryPoint": "setState"
    },
    {
      "id": "flash",
      "name": "Flash lights",
      "runtime": "js",
      "path": "functions/flash.js",
      "entryPoint": "flash"
    },
    {
      "id": "listLights",
      "name": "List lights",
      "runtime": "js",
      "path": "functions/listLights.js",
      "entryPoint": "listLights"
    }
  ],
  "actions": [
    {
      "id": "lifx.set_state",
      "name": "Set lights",
      "type": "function",
      "function": "setState",
      "description": "Turn lights on or off and set their color and brightness. Anything left blank stays as it is.",
      "schema": [
        {
          "id": "selector",
          "label": "Lights",
          "type": "text",
          "required": true,
          "defaultValue": "all",
          "placeholder": "all",
          "description": "All lights, a group, or one light.",
          "source": {
            "kind": "internal",
            "request": {
              "event": "barkloader.module.field_options",
              "payload": {
                "moduleId": "woofx3_lifx",
                "functionId": "listLights"
              }
            },
            "timeoutMs": 10000
          }
        },
        {
          "id": "power",
          "label": "Power",
          "type": "select",
          "defaultValue": "",
          "options": [
            {
              "value": "",
              "label": "Leave as is"
            },
            {
              "value": "on",
              "label": "On"
            },
            {
              "value": "off",
              "label": "Off"
            }
          ]
        },
        {
          "id": "color",
          "label": "Color",
          "type": "color",
          "description": "Leave blank to keep the current color."
        },
        {
          "id": "brightness",
          "label": "Brightness",
          "type": "number",
          "unit": "%",
          "min": 0,
          "max": 100,
          "placeholder": "Keep current",
          "description": "Leave blank to keep the current brightness."
        },
        {
          "id": "durationSeconds",
          "label": "Fade time",
          "type": "number",
          "unit": "seconds",
          "min": 0,
          "max": 3600,
          "defaultValue": 0,
          "description": "How long the change takes. 0 is instant."
        }
      ],
      "returns": {
        "fields": [
          {
            "path": "ok",
            "type": "boolean",
            "description": "True once LIFX accepted the change."
          },
          {
            "path": "lightsChanged",
            "type": "number",
            "description": "How many lights answered. A light that is offline or unplugged isn't counted."
          }
        ]
      },
      "taxonomy": [
        "platform.lifx"
      ]
    },
    {
      "id": "lifx.flash",
      "name": "Flash lights",
      "type": "function",
      "function": "flash",
      "description": "Flash lights in a color a few times, then return them to how they were. Great for alerts.",
      "schema": [
        {
          "id": "selector",
          "label": "Lights",
          "type": "text",
          "required": true,
          "defaultValue": "all",
          "placeholder": "all",
          "description": "All lights, a group, or one light.",
          "source": {
            "kind": "internal",
            "request": {
              "event": "barkloader.module.field_options",
              "payload": {
                "moduleId": "woofx3_lifx",
                "functionId": "listLights"
              }
            },
            "timeoutMs": 10000
          }
        },
        {
          "id": "color",
          "label": "Color",
          "type": "color",
          "required": true,
          "defaultValue": "#a970ff"
        },
        {
          "id": "style",
          "label": "Style",
          "type": "select",
          "defaultValue": "pulse",
          "options": [
            {
              "value": "pulse",
              "label": "Pulse: sharp on and off"
            },
            {
              "value": "breathe",
              "label": "Breathe: smooth fade in and out"
            }
          ]
        },
        {
          "id": "cycles",
          "label": "Number of flashes",
          "type": "number",
          "min": 1,
          "max": 50,
          "defaultValue": 3
        },
        {
          "id": "periodSeconds",
          "label": "Time per flash",
          "type": "number",
          "unit": "seconds",
          "min": 0.1,
          "max": 10,
          "defaultValue": 1
        }
      ],
      "returns": {
        "fields": [
          {
            "path": "ok",
            "type": "boolean",
            "description": "True once LIFX accepted the change."
          },
          {
            "path": "lightsChanged",
            "type": "number",
            "description": "How many lights answered. A light that is offline or unplugged isn't counted."
          }
        ]
      },
      "taxonomy": [
        "platform.lifx"
      ]
    }
  ]
}
