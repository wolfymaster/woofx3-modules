{
  "id": "woofx3_obs",
  "name": "OBS",
  "author": "WolfyMaster LLC",
  "version": "0.5.0",
  "category": "platform",
  "description": "Switch OBS scenes, show or hide sources, mute audio, and put a web page on screen.",
  "taxonomy": [
    "platform.obs"
  ],
  "permissions": [
    "obs.control"
  ],
  "settings": [
    {
      "id": "host",
      "label": "OBS address",
      "description": "The computer running OBS. The desktop app fills this in for you.",
      "type": "text",
      "defaultValue": "127.0.0.1",
      "required": true
    },
    {
      "id": "port",
      "label": "OBS port",
      "description": "The server port from OBS (4455 unless you changed it).",
      "type": "number",
      "defaultValue": "4455",
      "required": true
    },
    {
      "id": "password",
      "label": "OBS password",
      "description": "The server password from OBS. Leave it empty if you turned the password off.",
      "type": "secret",
      "required": false
    }
  ],
  "local": [
    {
      "id": "obs",
      "name": "OBS connection",
      "protocol": "websocket",
      "hostSetting": "host",
      "portSetting": "port",
      "passwordSetting": "password",
      "discover": {
        "known": "obs-websocket"
      }
    }
  ],
  "functions": [
    {
      "id": "switchScene",
      "name": "Switch scene",
      "runtime": "js",
      "path": "functions/switchScene.js",
      "entryPoint": "switchScene"
    },
    {
      "id": "setSourceVisibility",
      "name": "Show or hide a source",
      "runtime": "js",
      "path": "functions/setSourceVisibility.js",
      "entryPoint": "setSourceVisibility"
    },
    {
      "id": "setInputMute",
      "name": "Mute or unmute an input",
      "runtime": "js",
      "path": "functions/setInputMute.js",
      "entryPoint": "setInputMute"
    },
    {
      "id": "listScenes",
      "name": "List scenes",
      "runtime": "js",
      "path": "functions/listScenes.js",
      "entryPoint": "listScenes"
    },
    {
      "id": "listSources",
      "name": "List sources",
      "runtime": "js",
      "path": "functions/listSources.js",
      "entryPoint": "listSources"
    },
    {
      "id": "listInputs",
      "name": "List audio inputs",
      "runtime": "js",
      "path": "functions/listInputs.js",
      "entryPoint": "listInputs"
    },
    {
      "id": "showBrowserSource",
      "name": "Show a web page",
      "runtime": "js",
      "path": "functions/showBrowserSource.js",
      "entryPoint": "showBrowserSource"
    }
  ],
  "actions": [
    {
      "id": "obs.switch_scene",
      "name": "Switch scene",
      "description": "Switch to a scene in OBS.",
      "type": "function",
      "function": "switchScene",
      "schema": [
        {
          "id": "sceneName",
          "label": "Scene",
          "type": "text",
          "required": true,
          "placeholder": "BRB",
          "description": "The scene name, exactly as it appears in OBS.",
          "source": {
            "kind": "internal",
            "request": {
              "event": "barkloader.module.field_options",
              "payload": {
                "moduleId": "woofx3_obs",
                "functionId": "listScenes"
              }
            },
            "timeoutMs": 5000
          }
        }
      ],
      "returns": {
        "fields": [
          {
            "path": "ok",
            "type": "boolean",
            "description": "True once OBS made the change."
          }
        ]
      },
      "taxonomy": [
        "platform.obs"
      ]
    },
    {
      "id": "obs.set_source_visibility",
      "name": "Show or hide a source",
      "description": "Show, hide or toggle a source in a scene.",
      "type": "function",
      "function": "setSourceVisibility",
      "schema": [
        {
          "id": "sourceName",
          "label": "Source",
          "type": "text",
          "required": true,
          "placeholder": "Confetti",
          "description": "The source name, exactly as it appears in OBS.",
          "source": {
            "kind": "internal",
            "request": {
              "event": "barkloader.module.field_options",
              "payload": {
                "moduleId": "woofx3_obs",
                "functionId": "listSources"
              }
            },
            "timeoutMs": 5000
          }
        },
        {
          "id": "visibility",
          "label": "Visibility",
          "type": "select",
          "defaultValue": "visible",
          "options": [
            {
              "value": "visible",
              "label": "Visible"
            },
            {
              "value": "hidden",
              "label": "Hidden"
            },
            {
              "value": "toggle",
              "label": "Toggle"
            }
          ],
          "description": "Toggle flips it to whichever it isn't right now."
        },
        {
          "id": "sceneName",
          "label": "Scene",
          "type": "text",
          "placeholder": "Current scene",
          "description": "The scene the source is in. Leave blank for the current scene.",
          "source": {
            "kind": "internal",
            "request": {
              "event": "barkloader.module.field_options",
              "payload": {
                "moduleId": "woofx3_obs",
                "functionId": "listScenes"
              }
            },
            "timeoutMs": 5000
          }
        }
      ],
      "returns": {
        "fields": [
          {
            "path": "ok",
            "type": "boolean",
            "description": "True once OBS made the change."
          }
        ]
      },
      "taxonomy": [
        "platform.obs"
      ]
    },
    {
      "id": "obs.set_input_mute",
      "name": "Mute or unmute audio",
      "description": "Mute or unmute audio in OBS, like your microphone or desktop sound.",
      "type": "function",
      "function": "setInputMute",
      "schema": [
        {
          "id": "inputName",
          "label": "Audio",
          "type": "text",
          "required": true,
          "placeholder": "Mic/Aux",
          "description": "The audio name, exactly as it appears in the OBS mixer.",
          "source": {
            "kind": "internal",
            "request": {
              "event": "barkloader.module.field_options",
              "payload": {
                "moduleId": "woofx3_obs",
                "functionId": "listInputs"
              }
            },
            "timeoutMs": 5000
          }
        },
        {
          "id": "muted",
          "label": "Muted",
          "type": "toggle",
          "defaultValue": true,
          "description": "On mutes it. Off unmutes it."
        }
      ],
      "returns": {
        "fields": [
          {
            "path": "ok",
            "type": "boolean",
            "description": "True once OBS made the change."
          }
        ]
      },
      "taxonomy": [
        "platform.obs"
      ]
    },
    {
      "id": "obs.show_browser_source",
      "name": "Show a web page",
      "description": "Put a web page on screen. The browser source is added for you the first time.",
      "type": "function",
      "function": "showBrowserSource",
      "schema": [
        {
          "id": "url",
          "label": "Web page",
          "type": "text",
          "required": true,
          "placeholder": "https://www.twitch.tv/wolfymaster",
          "description": "The web address, starting with https://"
        },
        {
          "id": "sourceName",
          "label": "Browser source",
          "type": "text",
          "required": true,
          "placeholder": "Web page",
          "description": "The browser source name. It's added if it doesn't exist."
        },
        {
          "id": "sceneName",
          "label": "Scene",
          "type": "text",
          "placeholder": "Current scene",
          "description": "The scene to show it in. Leave blank for the current scene.",
          "source": {
            "kind": "internal",
            "request": {
              "event": "barkloader.module.field_options",
              "payload": {
                "moduleId": "woofx3_obs",
                "functionId": "listScenes"
              }
            },
            "timeoutMs": 5000
          }
        }
      ],
      "returns": {
        "fields": [
          {
            "path": "ok",
            "type": "boolean",
            "description": "True once OBS made the change."
          }
        ]
      },
      "taxonomy": [
        "platform.obs"
      ]
    }
  ]
}
